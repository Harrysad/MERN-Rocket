#!/bin/sh

reject() {
  printf 'pre-commit: %s\n' "$1" >&2
  exit 1
}

# Without quotePath=false, non-ASCII paths (e.g. Polish names) come out quoted and escape the checks.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=d)

# The empty root commit is the only way to create main locally.
if ! git rev-parse --verify -q HEAD > /dev/null && [ -z "$staged" ]; then
  exit 0
fi

if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ]; then
  reject "Committing directly to main is blocked. Create a branch first: git switch -c <name>"
fi

# .gitignore is the single list of files that must never be committed; this catches `git add -f`.
ignored=$(printf '%s\n' "$staged" | grep . | git -c core.quotePath=false check-ignore --no-index --stdin)
if [ -n "$ignored" ]; then
  reject "These files are listed in .gitignore and must not be committed: $ignored"
fi

if git diff --cached -U0 -- '*.env.example' | grep -qE '^\+[A-Z0-9_]*(SECRET|KEY|TOKEN|PASS)[A-Z0-9_]*=.+'; then
  reject "A secret-like variable in .env.example has a value. Keep it empty there."
fi

if ! command -v gitleaks > /dev/null 2>&1; then
  reject "gitleaks is required to scan for secrets. Install it: winget install --id Gitleaks.Gitleaks -e"
fi

gitleaks git --pre-commit --staged --redact --no-banner || reject "gitleaks found a possible secret in the staged changes."
