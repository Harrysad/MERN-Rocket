#!/bin/sh

msg_file="$1"

# Drop the diff that `git commit -v` appends below the scissors line.
message=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$msg_file")
subject=$(printf '%s\n' "$message" | head -n 1)

reject() {
  printf 'commit-msg: %s\n' "$1" >&2
  exit 1
}

# Checked on the whole file, comments and scissors included: with -F or -m git strips
# neither, so such a line would end up in history. Diff lines start with +, - or a space.
if grep -qiE '^(# ?)?co-authored-by[[:space:]]*:' "$msg_file"; then
  reject "Co-Authored-By lines are not allowed in this repository."
fi

if printf '%s\n' "$message" | grep -qiE '(^|[^a-z0-9])(claude|anthropic|chatgpt|openai|copilot|gemini)([^a-z0-9]|$)|(^|[^a-z0-9])ai[- ](generated|assisted)'; then
  reject "AI tool names and AI attribution are not allowed in commit messages."
fi

# Messages generated by git itself skip the format check (not the checks above).
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|chore|refactor|test|ci|style|perf|build)(\([a-z0-9-]+\))?!?: .+'; then
  reject "Subject must follow Conventional Commits, e.g. 'fix(frontend): short description'."
fi

if [ "${#subject}" -gt 72 ]; then
  reject "Subject is ${#subject} characters long; the limit is 72."
fi

exit 0
